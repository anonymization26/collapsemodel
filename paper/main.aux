\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Label-free data-pool compression pipeline. \textbf  {Top:}\nobreakspace  {}Three SVD-channel statistics ($\Sigma {:}\gamma $, $V{:}\alpha $, $U{:}\ensuremath  {r_{\mathrm  {eff}}}\xspace  $) per dataset feed Lemma\nobreakspace  {}\ref {lem:gram}+Prop.\nobreakspace  {}\ref {prop:collapse} to predict merged rank and superadditivity threshold $\rho _c(\alpha ,\gamma )$. \textbf  {Middle:}\nobreakspace  {}Three behaviour regimes in the $(\alpha ,\gamma )$ plane (Cor.\nobreakspace  {}\ref {cor:superadd}): superadditive, directional collapse ($\alpha {\to }1$), energy collapse ($\gamma {\gg }1$ or ${\ll }1$). \textbf  {Bottom:}\nobreakspace  {}Greedy loop (Alg.\nobreakspace  {}\ref {alg:collapse_greedy}): score remaining candidates, pick $\arg \max $, repeat $k$ times; outputs compressed pool $S$.\relax }}{3}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:framework}{{1}{3}{Label-free data-pool compression pipeline. \textbf {Top:}~Three SVD-channel statistics ($\Sigma {:}\gamma $, $V{:}\alpha $, $U{:}\reff $) per dataset feed Lemma~\ref {lem:gram}+Prop.~\ref {prop:collapse} to predict merged rank and superadditivity threshold $\rho _c(\alpha ,\gamma )$. \textbf {Middle:}~Three behaviour regimes in the $(\alpha ,\gamma )$ plane (Cor.~\ref {cor:superadd}): superadditive, directional collapse ($\alpha {\to }1$), energy collapse ($\gamma {\gg }1$ or ${\ll }1$). \textbf {Bottom:}~Greedy loop (Alg.~\ref {alg:collapse_greedy}): score remaining candidates, pick $\arg \max $, repeat $k$ times; outputs compressed pool $S$.\relax }{figure.caption.2}{}}
