\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Bimodal principal-angle structure} (CIFAR-10\,$\times $\,ImageNet-Animal, $k{=}20$). \textbf  {(a)}\nobreakspace  {}Per-dimension $\cos ^2\theta _i$: ResNet-50 ($\ensuremath  {\mathrm  {SA}_k}\xspace  {=}0.039$, $V_\alpha {=}0.019$) decays monotonically from one dominant direction; CLIP ($\ensuremath  {\mathrm  {SA}_k}\xspace  {=}0.414$, $V_\alpha {=}0.090$) and DINO ($\ensuremath  {\mathrm  {SA}_k}\xspace  {=}0.355$, $V_\alpha {=}0.073$) form a two-cluster step (top-5 ratios $20{\times }$/$31{\times }$ over bot-5), violating the uniform-$\alpha $ assumption. \textbf  {(b)}\nobreakspace  {}Geometric interpretation: one shared spine plus orthogonal domain-specific wings. \textbf  {(c)}\nobreakspace  {}Alignment variance $V_\alpha $ predicts upward formula bias across 166 pairs (OLS slope 0.69), consistent with Theorem\nobreakspace  {}\ref {thm:error}'s $V_\alpha \log \kappa $ term.\relax }}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:bimodal_structure}{{2}{7}{\textbf {Bimodal principal-angle structure} (CIFAR-10\,$\times $\,ImageNet-Animal, $k{=}20$). \textbf {(a)}~Per-dimension $\cos ^2\theta _i$: ResNet-50 ($\SAk {=}0.039$, $V_\alpha {=}0.019$) decays monotonically from one dominant direction; CLIP ($\SAk {=}0.414$, $V_\alpha {=}0.090$) and DINO ($\SAk {=}0.355$, $V_\alpha {=}0.073$) form a two-cluster step (top-5 ratios $20{\times }$/$31{\times }$ over bot-5), violating the uniform-$\alpha $ assumption. \textbf {(b)}~Geometric interpretation: one shared spine plus orthogonal domain-specific wings. \textbf {(c)}~Alignment variance $V_\alpha $ predicts upward formula bias across 166 pairs (OLS slope 0.69), consistent with Theorem~\ref {thm:error}'s $V_\alpha \log \kappa $ term.\relax }{figure.caption.5}{}}
