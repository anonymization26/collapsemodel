    "prior_precision": 1.0,
    "noise_variance": 1.0,
    "subspace_rank": 16,
    "shortlist_sizes": [
      10,
      25,
      50,
      100,
      227
    ],
    "primary_shortlist_size": 227,
    "random_repeats": 20,
    "random_seed": 20260911,
    "tie_break": "score-then-lexicographic-combination",
    "uses_source_labels": false,
    "uses_target_validation_labels": false,
    "uses_target_test_features": false,
    "uses_target_test_labels": false
