    "anchor_is_an_evaluator": false,
    "row_l2_normalize": true,
    "center_within_domain": true,
    "axis": "largest-eigenvector-of-anchor-covariance",
    "axis_sign": "largest-absolute-loading-positive",
    "strata": [
      "low",
      "middle",
      "high"
    ],
    "stratum_rule": "stable-sort-projection-then-split-into-three-equal-contiguous-groups",
    "candidate_samples_per_stratum": 512,
