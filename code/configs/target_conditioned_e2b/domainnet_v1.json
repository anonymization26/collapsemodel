      "seed": 20260911,
      "scale": "one-over-sqrt-output-dimension",
      "shared_across_domains_and_roles_within_encoder": true,
      "post_projection_row_l2_normalize": true,
      "uses_labels_or_test_outcomes": false
    }
  },
  "combinations": {
