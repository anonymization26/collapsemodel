  "primary_analysis": {
    "unit": "target-domain",
    "encoder_handling": "average-within-target-domain",
    "primary_method": "target_a",
    "bootstrap_repeats": 10000,
    "confidence_level": 0.95,
    "success_gate": {
      "primary_shortlist_reduction_at_least": 0.5,
      "mean_true_top_q_recall_at_least": 0.9,
      "mean_validation_selected_normalized_regret_at_most": 0.05
