    "single_dataset_limitation": "six target domains are paired units but do not establish cross-dataset generality"
  },
  "stop_rules": {
    "insufficient_quota": "abort-without-changing-counts",
    "candidate_count_mismatch": "abort",
    "unequal_block_size": "abort",
    "combination_count_mismatch": "abort",
    "test_access_before_validation_freeze": "invalidate-run",
    "primary_gate_failure": "report-negative-result-and-do-not-claim-effective-prescreening"
  },
  "claim_boundary": "E2b is a new exploratory hypothesis on an independent dataset. It cannot retroactively rescue E2 H2 or H2b. Passing H3 on DomainNet supports only equal-cost shortlist pre-screening for frozen linear readouts under this protocol."
