    "official_split_policy": {
      "target_selection": "official-train",
      "target_validation": "official-train",
      "anchor_pool": "official-train",
      "target_test": "official-test"
    },
    "train_roles_are_disjoint_within_domain": true,
    "invalid_image_policy": "skip-in-hash-order-and-replenish-before-freeze",
    "duplicate_content_policy": "retain-first-in-frozen-domain-role-hash-traversal-and-replenish-before-freeze",
    "role_order": [
      "target_selection",
      "target_validation",
      "anchor_pool",
      "target_test"
    ],
    "uses_labels_for_within_subset_assignment": false,
    "uses_model_outputs": false
  },
  "candidate_construction": {
