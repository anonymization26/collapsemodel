{
  "schema_version": "target-conditioned-e2-experiment-config-v1",
  "status": "frozen-before-method-evaluation",
  "datasets": [
    "pacs",
    "office_home"
  ],
  "encoders": [
    "resnet50",
    "dinov2_b14"
  ],
  "feature_transform": {
    "name": "row-l2-normalize",
    "epsilon": 1e-08,
    "intercept": false,
    "centering": "none"
  },
  "selection": {
    "budgets": [
      1,
      3,
      5
    ],
    "primary_budget": 3,
    "prior_precision": 1.0,
    "noise_variance": 1.0,
    "subspace_rank": 32,
    "rank_l": 32,
    "random_repeats": 20,
    "random_seed": 20260911,
    "candidate_cost": "one-per-manifest-block",
    "uses_source_labels": false,
    "uses_target_labels": false,
    "uses_target_calibration": false,
    "uses_target_test": false
  },
  "evaluation": {
    "ridge_regularization": 1.0,
    "primary_metric": "brier_score",
    "supporting_metrics": [
      "squared_loss",
      "nll",
      "accuracy",
      "macro_f1",
      "ece"
    ],
    "ece_bins": 15,
    "target_test_opened_after_selection_freeze": true
  },
  "primary_analysis": {
    "unit": "dataset-target-domain",
    "encoder_handling": "average-within-unit",
    "bootstrap_repeats": 10000,
    "confidence_level": 0.95,
    "noninferiority_relative_tolerance": 0.005,
    "minimum_mean_relative_improvement": 0.02,
    "minimum_noninferior_unit_fraction": 0.7
  },
  "method_groups": {
    "target_conditioned": [
      "target_a",
      "target_energy",
      "second_moment_mmd"
    ],
    "target_blind": [
      "bayesian_d",
      "collapse_4s",
      "domain_balance",
      "dpp_subspace",
      "effective_rank",
      "facility_subspace",
      "kcenter_subspace",
      "random",
      "size",
      "spectrum_rank_l"
    ]
  },
  "claim_boundary": "Data preparation and selection proxies do not constitute H2; only frozen target-test evaluation after selection freeze can test H2."
}
